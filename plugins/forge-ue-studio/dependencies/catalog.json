{
  "schema_version": 2,
  "dependencies": [
    {
      "id": "resident-host",
      "classification": "core-resident-default",
      "capabilities": [
        "host.resident",
        "worker.orchestration",
        "worker.design",
        "worker.code",
        "worker.review",
        "worker.visual-generation",
        "worker.tool-operation",
        "worker.resident",
        "worker.visual-direction",
        "worker.storyboard"
      ],
      "fallback": null,
      "host_assigned": true,
      "assigned_in": ".forge/runtime.json",
      "note": "The resident seat is an assignment, not a vendor. Any host satisfying the Forge prerequisite contract may hold it.",
      "known_hosts_source": "plugins/forge-ue-studio/hosts/registry.json",
      "routing": "declared",
      "routing_note": "The resident seat is filled by host assignment, not by a route. Its capabilities are exercised directly by whichever host holds the seat."
    },
    {
      "id": "gsd",
      "classification": "core-phase-engine",
      "capabilities": [
        "workflow.gsd",
        "forge.state"
      ],
      "fallback": "minimal-fork-only-after-extension-gap-test",
      "source": "https://github.com/open-gsd/gsd-core",
      "install": {
        "package": "@opengsd/gsd-core",
        "pinned_version": "1.10.0",
        "runtime": "resident-host",
        "scope": "global",
        "preview_command": ".\\install.ps1 -Mode GSD -RuntimeHost <id>",
        "apply_command": ".\\install.ps1 -Mode GSD -RuntimeHost <id> -Apply",
        "requires_user_approval": true,
        "pin_rationale": "Matches the version Forge is tested against. Validated against 1.10.0: the smart-entry contract is unchanged, and every workflow the verb registry fronts resolves."
      },
      "routing": "declared",
      "routing_note": "Invoked as a phase engine through its own skill surface, not dispatched as a Forge capability route."
    },
    {
      "id": "unreal-engine",
      "classification": "required-for-unreal-execution",
      "capabilities": [
        "ue.project",
        "ue.build",
        "ue.cook",
        "ue.asset-import",
        "ue.sequencer",
        "qa.gameplay",
        "qa.release",
        "platform.sdk"
      ],
      "fallback": "planning-research-and-dcc-only",
      "routing": "declared",
      "routing_note": "The engine itself is a prerequisite, not a dispatch target. Work reaches it through a typed tool route or the editor-closed fallback."
    },
    {
      "id": "vcs",
      "classification": "required-before-production-writes",
      "capabilities": [
        "vcs.revision",
        "vcs.rollback",
        "vcs.ownership"
      ],
      "fallback": "read-only",
      "routing": "declared",
      "routing_note": "Exercised through git directly by the isolation and lease machinery."
    },
    {
      "id": "unreal-native-mcp",
      "classification": "recommended-optional-route",
      "capabilities": [
        "ue.live.typed",
        "ue.pie",
        "ue.viewport"
      ],
      "fallback": "ue.editor-closed-or-human",
      "routing": "routed"
    },
    {
      "id": "unreal-python",
      "classification": "recommended-optional-route",
      "capabilities": [
        "ue.python.commandlet",
        "ue.batch"
      ],
      "fallback": "ue.native-mcp-or-cpp-uat",
      "routing": "routed",
      "routing_note": "Editor-closed Unreal API and commandlets, reached through the process route in route-registry.json. A primary production surface for batch and bulk work, not the degraded path taken when the live editor is missing."
    },
    {
      "id": "vibeue",
      "classification": "optional-accelerator",
      "capabilities": [
        "ue.live.python"
      ],
      "fallback": "ue.native-mcp-plus-editor-closed-python",
      "routing": "declared",
      "routing_note": "Optional accelerator with no typed tool route declared yet."
    },
    {
      "id": "blender-gateway",
      "classification": "optional-dcc-route",
      "capabilities": [
        "dcc.mesh",
        "dcc.rig",
        "dcc.animation",
        "dcc.export",
        "dcc.authoring"
      ],
      "fallback": "ue-authoring-or-approved-assets-or-placeholders",
      "routing": "routed"
    },
    {
      "id": "resident-imagegen",
      "classification": "resident-visual-generation-surface",
      "capabilities": [
        "visual.raster.generate",
        "visual.raster.edit",
        "visual.texture",
        "visual.sprite",
        "visual.board"
      ],
      "fallback": "licensed-references-or-placeholders",
      "routing": "declared",
      "routing_note": "Exercised through the resident host's own image surface when it exposes one; no separate route."
    },
    {
      "id": "resident-image-direction",
      "classification": "resident-visual-planning-surface",
      "capabilities": [
        "visual.reference-decomposition",
        "visual.character-sheet",
        "visual.turnaround",
        "visual.storyboard",
        "visual.prompt-contract"
      ],
      "fallback": "manual-visual-brief",
      "routing": "declared",
      "routing_note": "Prompt-level direction performed by the resident host; no separate route."
    },
    {
      "id": "resident-video-direction",
      "classification": "resident-cinematics-planning-surface",
      "capabilities": [
        "cinematic.storyboard",
        "cinematic.shot-card",
        "cinematic.previs",
        "cinematic.continuity",
        "audio.direction"
      ],
      "fallback": "manual-shot-list",
      "routing": "declared",
      "routing_note": "Prompt-level direction performed by the resident host; no separate route."
    },
    {
      "id": "resident-creative-methods",
      "classification": "resident-optional-ideation-method",
      "capabilities": [
        "design.divergent-ideation",
        "design.adversarial-scoring",
        "design.refinement"
      ],
      "fallback": "forge-brainstorming",
      "routing": "declared",
      "routing_note": "Prompt-level method applied by the resident host; no separate route."
    },
    {
      "id": "resident-spreadsheets",
      "classification": "resident-optional-production-reporting-surface",
      "capabilities": [
        "production.scorecard.xlsx",
        "production.scorecard.csv",
        "production.scorecard.visual-qa"
      ],
      "fallback": "canonical-json-scorecard",
      "routing": "declared",
      "routing_note": "Produced by the resident host through ordinary file writes; no separate route."
    },
    {
      "id": "graphify",
      "classification": "optional-research-graph",
      "capabilities": [
        "research.relationship-graph",
        "research.retrieval",
        "research.community-analysis",
        "research.ingest",
        "research.graph"
      ],
      "fallback": "indexed-domain-cards",
      "routing": "declared",
      "routing_note": "Invoked as a CLI when present; no typed tool route declared yet."
    },
    {
      "id": "ollama",
      "classification": "optional-local-model-runtime",
      "capabilities": [
        "model.local.discovery",
        "model.local.inference"
      ],
      "fallback": "resident-host",
      "routing": "declared",
      "routing_note": "Local model runtime discovered by probe and used through its own endpoint; no typed tool route."
    },
    {
      "id": "lm-studio",
      "classification": "optional-local-model-runtime",
      "capabilities": [
        "model.local.discovery",
        "model.openai-compatible-endpoint"
      ],
      "fallback": "ollama-or-resident-host",
      "routing": "declared",
      "routing_note": "Local model runtime discovered by probe and used through its own endpoint; no typed tool route."
    },
    {
      "id": "local-model-runtime",
      "classification": "optional-offload-runtime",
      "capabilities": [
        "model.local",
        "worker.context-heavy-bounded",
        "worker.code-review",
        "worker.visual-breakdown",
        "worker.tool-operation",
        "model.local.runtime"
      ],
      "fallback": "resident-host",
      "routing": "declared",
      "routing_note": "Abstract worker capability satisfied by whichever local runtime qualifies; no typed tool route."
    }
  ],
  "routing_states": {
    "routed": "At least one capability is served by a declared provider and bound to an agent that can execute it.",
    "declared": "Known to Forge and usable by name, but nothing dispatches work to it as a capability route. The note says how it is actually exercised."
  }
}
