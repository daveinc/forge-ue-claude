{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.procedure/v1",
  "type": "object",
  "required": ["schema", "procedures"],
  "properties": {
    "schema": {"const": "forge.procedure/v1"},
    "note": {"type": "string"},
    "procedures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["lane", "capabilities", "steps", "non_goals", "acceptance", "verification", "evidence"],
        "properties": {
          "lane": {"type": "string", "pattern": "^lane\\."},
          "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["does", "produces", "capability"],
              "properties": {
                "does": {"type": "string", "minLength": 1},
                "produces": {"type": "string", "minLength": 1},
                "capability": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "non_goals": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "acceptance": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "verification": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
