{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.route-provider/v1",
  "type": "object",
  "required": ["id", "kind", "capabilities", "lane", "isolation_mode", "requires_host_provides", "probe", "fallbacks", "permissions", "acceptance_suites", "invalidation_triggers"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "description": "Must match a dependency id in catalog.json."},
    "server": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Required when kind is mcp. Host-neutral server id; the host registry composes the concrete tool namespace from it."},
    "command": {"type": "string", "minLength": 1, "description": "Required when kind is process. The executable the host runs; never a shell line."},
    "kind": {"enum": ["mcp", "process"]},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "lane": {"type": "string", "minLength": 1, "description": "Must be declared in the registry's lanes map."},
    "isolation_mode": {"enum": ["read-only", "git-worktree", "lfs-lock", "project-exclusive"]},
    "locality": {"enum": ["resident", "local", "remote", "human"]},
    "requires_host_provides": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "probe": {"type": "string", "minLength": 1, "description": "Must be declared in the registry's probe_kinds map."},
    "fallbacks": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "permissions": {
      "type": "object",
      "required": ["read", "write", "network", "secrets"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "network": {"type": "boolean"},
        "secrets": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "acceptance_suites": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "invalidation_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": true,
  "allOf": [
    {"if": {"properties": {"kind": {"const": "mcp"}}}, "then": {"required": ["server"]}},
    {"if": {"properties": {"kind": {"const": "process"}}}, "then": {"required": ["command"]}}
  ]
}
