{
  "schema": "forge.verb-registry/v1",
  "policy": {
    "surface": "forge",
    "unmapped_action": "fail",
    "note": "Forge owns the entire user-facing vocabulary. GSD is never addressed directly and is never edited or copied \u2014 it is invoked in place so upstream fixes arrive for free. This registry is the single boundary where GSD's structured command emissions become Forge verbs.",
    "dispositions": {
      "front": "A Forge verb fronts this GSD command.",
      "drop": "Deliberately outside Forge's surface. Suppressed from routed actions with a recorded reason, never shown as an unmapped leak."
    },
    "via": {
      "command": "GSD installs a skill of this name; smart-entry can emit it, so translation matters.",
      "workflow": "No GSD command of this name exists \u2014 the workflow is reached through a parent skill or internally. Forge fronts the workflow file directly under containment."
    }
  },
  "delegation_modes": {
    "contain": "Forge spawns a subagent that reads and follows the stock GSD workflow on disk and returns a structured result. The transcript never reaches the user, so GSD's own command strings cannot leak.",
    "relay": "The workflow is interactive and cannot be black-boxed. Forge relays each question in game-dev framing and passes answers back down, translating any action identifier it surfaces.",
    "native": "Forge owns the behaviour outright. No GSD workflow is involved."
  },
